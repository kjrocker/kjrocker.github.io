---
import Layout from "../layouts/Layout.astro";

const title = "About - Kevin Rocker";
const description = "A bit about me, what I like, and what I do";
const pageTitle = "About Me";
---

<Layout {title} {description} {pageTitle}>
  <section class="max-w-prose mx-auto md:text-sm flex flex-col my-10 gap-y-10">
    <p>
      I'm a professional software developer and as of 2021 a digital nomad. I
      specialize in Typescript, PostgreSQL, and functional programming. When I'm
      not working I'm out taking photos, listening to audiobooks, going on long
      walks in the city, or working on one of my ever-expanding side projects.
    </p>

    <p>
      I believe in fast, efficient websites. This site is built in Astro and
      uses modern web technologies, without a drop of Javascript.
    </p>
  </section>
</Layout>
